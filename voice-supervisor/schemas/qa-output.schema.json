{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrueMate Voice Supervisor QA Output",
  "type": "object",
  "required": ["call_id", "overall_score", "health_status", "dimensions", "findings", "critical_error", "summary"],
  "properties": {
    "call_id": {"type": "string"},
    "overall_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "health_status": {"type": "string", "enum": ["HEALTHY", "MONITOR", "DEGRADED", "CRITICAL"]},
    "critical_error": {"type": "boolean"},
    "audio_review_performed": {"type": "boolean"},
    "audio_review_needed": {"type": "boolean"},
    "dimensions": {
      "type": "object",
      "properties": {
        "pronunciation": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "naturalness": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "listening_comprehension": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "turn_taking": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "repetition_loops": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "response_accuracy": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "flow_adherence": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "question_handling": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "closing_quality": {"type": ["integer", "null"], "minimum": 0, "maximum": 100}
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "severity", "description", "evidence_type", "confidence"],
        "properties": {
          "timestamp_start": {"type": ["number", "null"], "minimum": 0},
          "timestamp_end": {"type": ["number", "null"], "minimum": 0},
          "category": {"type": "string"},
          "severity": {"type": "string", "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"]},
          "description": {"type": "string"},
          "evidence": {"type": ["string", "null"]},
          "evidence_type": {"type": "string", "enum": ["TRANSCRIPT", "AUDIO", "METADATA", "COMBINED"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "recommended_action": {"type": ["string", "null"]}
        }
      }
    },
    "summary": {"type": "string"}
  },
  "additionalProperties": false
}
